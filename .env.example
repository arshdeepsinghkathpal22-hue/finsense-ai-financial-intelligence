# FinSense AI configuration template.
#
# run.sh / run.bat copy this file to .env on first use and replace every
# "change-me-..." password with a random value. If you copy it by hand,
# replace them yourself (letters and digits only, so they are URL-safe).
# Never commit or share your real .env file.

# ---------------------------------------------------------------- Database
POSTGRES_DB=finsense
# Owner/bootstrap role (runs migrations; in Docker it is the database superuser).
POSTGRES_USER=finsense_owner
POSTGRES_PASSWORD=change-me-owner-password
# Least-privilege runtime role used by the API (finsense_app).
APP_DB_PASSWORD=change-me-app-password

# Used only when running the backend directly on your machine (not in Docker).
# Keep the passwords in sync with the two values above.
DATABASE_URL=postgresql+psycopg://finsense_app:change-me-app-password@localhost:5432/finsense
MIGRATION_DATABASE_URL=postgresql+psycopg://finsense_owner:change-me-owner-password@localhost:5432/finsense

# ---------------------------------------------------------------- Web / security
# Address the browser uses. Also the only origin allowed by CORS.
PUBLIC_APP_URL=http://localhost:8080
WEB_PORT=8080
# 127.0.0.1 = reachable from this computer only. Use 0.0.0.0 to expose on your network.
WEB_BIND=127.0.0.1
# Uncomment and set to true when the site is served over HTTPS (required for real
# deployments). Unset: Docker uses false (plain http://localhost); native mode too.
# COOKIE_SECURE=true
# Interactive API documentation at /api/docs. Unset: off in Docker, on in native mode.
# Keep it false on internet-facing servers.
# EXPOSE_API_DOCS=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Demo data
# Load the synthetic (fictional) funds and sample documents on first start.
SEED_DEMO_DATA=true
# Annual risk-free rate used for Sharpe/Sortino (users can override per account).
RISK_FREE_RATE=0.065

# ---------------------------------------------------------------- Optional: language model
# none = the assistant quotes the most relevant passages verbatim (fully offline).
# anthropic = Anthropic Messages API (set LLM_MODEL and LLM_API_KEY).
# openai_compatible = any /chat/completions server, e.g. Ollama:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ---------------------------------------------------------------- Optional: live NAVs and e-mail
# Daily NAVs from AMFI's public NAVAll.txt for schemes an administrator registers.
AMFI_ENABLED=false
# SMTP for password-reset e-mails (password reset is disabled when SMTP_HOST is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
